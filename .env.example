PREFIX=Ev3R
SUFFIX=rDEND

# Set to 1 for exact case match (much harder)
# CASE_SENSITIVE=0

# Worker count is auto-detected from CPU cores. Only set this to override:
# CPU=8

# --- Telegram notification on match (optional) ---
# Get a bot token from @BotFather, then add the bot to your channel/group
# as an admin (needed to post messages) and get its chat id (e.g. via
# @userinfobot, or the -100xxxxxxxxxx id for a channel).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to 1 to include the private seed hex in the Telegram message.
# NOT recommended — Telegram is not a secure secret store. Default: 0
# (the message will just say found.jsonl has it, on the host).
# TELEGRAM_INCLUDE_SEED=0
